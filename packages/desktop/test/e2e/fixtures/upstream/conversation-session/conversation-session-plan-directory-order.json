        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_PLAN_DIRECTORY_ORDER"]
      },
      "response": {
        "statusCode": 200,
        "statusMessage": "OK",
        "headers": {
          "content-type": "application/json; charset=utf-8"
