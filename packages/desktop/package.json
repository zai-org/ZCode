{
  "name": "@zcode/desktop",
  "private": true,
  "description": "ZCode Desktop App",
  "author": "ZCode",
  "type": "module",
  "main": "out/main/index.js",
  "imports": {
    "#e2e/*": "./test/e2e/*.ts",
    "#src/*": "./src/*"
  },
  "scripts": {
    "pre-dev": "node scripts/ensure-local-runtime-assets.mjs && node -e \"require('node:fs').rmSync('./out',{recursive:true,force:true})\"",
    "dev": "node ../../scripts/dev-desktop-env.mjs production",
    "pre-dev:local-cli": "pnpm --dir ../.. exec node scripts/build-desktop-agent-cli.mjs && node -e \"require('node:fs').rmSync('./out',{recursive:true,force:true})\"",
    "dev:local-cli": "pnpm pre-dev:local-cli && concurrently -k -n tsup,vite,electron \"tsup --watch src --watch ../services/src --watch ../server/src --watch ../shared/src --watch ../rpc/src --watch ../client/src --watch ../provider/src --watch ../provider-node/src --ignore-watch 'mock-cdn/**' --ignore-watch 'bundled-agents/**' --ignore-watch '.e2e-cache/**' --ignore-watch '.e2e-artifacts/**' --ignore-watch '.e2e-home-*/**' --ignore-watch 'dist-cua-helper/**'\" \"vite dev\" \"node scripts/dev.mjs\"",
    "dev:runtime": "concurrently -k -n tsup,vite,electron \"tsup --watch src --watch ../services/src --watch ../server/src --watch ../shared/src --watch ../rpc/src --watch ../client/src --watch ../provider/src --watch ../provider-node/src --ignore-watch 'mock-cdn/**' --ignore-watch 'bundled-agents/**' --ignore-watch '.e2e-cache/**' --ignore-watch '.e2e-artifacts/**' --ignore-watch '.e2e-home-*/**' --ignore-watch 'dist-cua-helper/**'\" \"vite dev\" \"node scripts/dev.mjs\"",
    "prepare:build-meta": "node scripts/build-metadata.mjs",
    "prepare:runtime-assets": "node scripts/prepare-runtime-assets.mjs",
    "prepare:glm": "node ../../scripts/download-glm.mjs",
    "prepare:agent-bundle": "node scripts/prepare-agent-node-bundle.mjs",
    "prepare:windows-cua-helper": "node scripts/prepare-windows-cua-helper.mjs",
    "prepare:windows-runtime-host": "node ../../scripts/build-windows-runtime-host.mjs",
    "prepare:native-search": "node ../../scripts/prepare-native-search-tools.mjs",
    "prepare:browser-import-helper": "node scripts/build-windows-browser-import-helper.mjs",
    "prepare:macos-window-bounds": "node scripts/build-macos-window-bounds.mjs",
    "build:no-runtime-assets": "pnpm prepare:build-meta && node scripts/run-production-build.mjs",
    "build": "pnpm prepare:runtime-assets && pnpm run build:no-runtime-assets",
    "test:installer-nsh-smoke": "node scripts/test-installer-nsh-smoke.mjs",
    "test:auto-update-install-reentry-smoke": "node scripts/auto-update-install-reentry-smoke.mjs",
    "test:auto-update-ca-constraints-smoke": "node scripts/auto-update-ca-constraints-smoke.mjs",
    "test:project-token-retry-after-smoke": "node scripts/project-token-retry-after-smoke.mjs",
    "test:auto-update-source-security-smoke": "node scripts/auto-update-source-security-smoke.mjs && node scripts/auto-update-source-security-smoke.mjs --appimage && node scripts/auto-update-source-security-smoke.mjs --nsis",
    "test:browser-background-activity-smoke": "electron scripts/browser-background-activity-smoke.mjs",
    "test:browser-hidden-guest-screenshot-smoke": "electron scripts/browser-hidden-guest-screenshot-smoke.mjs",
    "test:browser-screenshot-surface-smoke": "electron scripts/browser-screenshot-surface-smoke.mjs",
    "pretest:browser-webm-recording-smoke": "tsup",
    "test:browser-webm-recording-smoke": "electron scripts/browser-webm-recording-smoke.mjs",
    "pretest:e2e": "pnpm --filter @zcode/e2e-report build:node",
    "test:e2e": "node scripts/run-windows-e2e-shards.mjs",
    "test:e2e:all:coverage": "node scripts/run-all-e2e-coverage.mjs",
    "pretest:e2e:serial": "pnpm --filter @zcode/e2e-report build:node",
    "test:e2e:serial": "wdio run wdio.conf.ts",
    "test:e2e:windows:sharded": "pnpm test:e2e -- --shards=10",
    "e2e:fixture:check": "node scripts/check-e2e-fixtures.mjs",
    "e2e:telemetry:fields": "node scripts/audit-telemetry-fields.mjs",
    "e2e:promote": "node scripts/promote-conversation-e2e.mjs",
    "e2e:docker:admit": "node scripts/admit-conversation-e2e-docker.mjs",
    "e2e:docker:admit:plugins": "node scripts/admit-plugin-e2e-docker.mjs",
    "e2e:promote:plugins": "node scripts/promote-plugin-e2e.mjs",
    "e2e:session-lifecycle:stress": "node scripts/run-e2e-session-lifecycle-stress.mjs",
    "typecheck:e2e": "pnpm --filter @zcode/e2e-report build:node && tsc -p tsconfig.e2e.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "audit:bundle-size": "node scripts/audit-bundle-size.mjs",
    "postinstall": "node scripts/node-pty-rebuild.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:agent-crash-diagnostic": "tsx --test test/agent-crash-diagnostic.node.test.ts",
    "test:e2e:retention": "tsx --test test/e2e/conversation-session/runtime/manual-review/pending/conversation-session-snapshot-retention.test.ts"
  },
  "dependencies": {
    "@arms/rum-electron": "^0.0.3",
    "@babel/runtime": "^7.24.5",
    "@fiahfy/icns": "^0.0.7",
    "@larksuiteoapi/node-sdk": "1.61.1",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@napi-rs/keyring": "2.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.214.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.214.0",
    "@opentelemetry/resources": "2.6.1",
    "@opentelemetry/sdk-metrics": "2.6.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@zcode/client": "workspace:*",
    "@zcode/e2e-report": "workspace:*",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@zcode/rpc": "workspace:*",
    "@zcode/server": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/ui": "workspace:*",
    "@zcode/zcode-cua": "workspace:*",
    "electron-updater": "6.8.10",
    "module-details-from-path": "^1.0.4",
    "node-forge": "^1.4.0",
    "node-pty": "^1.0.0",
    "pkijs": "3.4.3",
    "playwright-core": "1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.7.4",
    "ssh2": "^1.16.0",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.0.3",
    "@puppeteer/browsers": "2.13.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@wdio/cli": "^9.27.0",
    "@wdio/electron-types": "^9.2.1",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "dotenv": "^17.4.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-to-chromium": "1.5.452",
    "esbuild": "^0.25.0",
    "http-mitm-proxy": "^1.1.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "react-scan": "0.5.7",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "wdio-electron-service": "^9.2.1",
    "webdriverio": "^9.27.0"
  },
  "productName": "ZCode"
}
