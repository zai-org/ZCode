    },
    {
      "id": "sse-stall-tool-input-recovered",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fast-text",
      "syntheticReason": "证明未提交工具不会阻止安全恢复。"
    },
    {
      "id": "sse-stall-tool-committed-stalled",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fault-stream",
      "syntheticReason": "在 tool content block 完整但 message 未 terminal 的边界制造 stall，诊断是否执行、恢复和重复。"
    },
    {
      "id": "sse-stall-tool-committed-continuation",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fast-text",
      "syntheticReason": "证明 content_block_stop 已提交并执行工具，成功 tool_result 成为恢复锚点。"
