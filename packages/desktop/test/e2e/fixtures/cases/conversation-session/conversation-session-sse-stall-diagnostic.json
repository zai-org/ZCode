    {
      "id": "sse-stall-post-tool-continuation-recovered",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fast-text",
      "syntheticReason": "证明 post-tool continuation 只重试模型请求，不重复执行工具。"
