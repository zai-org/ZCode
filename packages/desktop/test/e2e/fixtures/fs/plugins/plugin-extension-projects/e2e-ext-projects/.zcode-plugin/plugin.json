{
  "name": "e2e-ext-projects",
  "version": "1.0.0",
  "description": "E2E extension fixture: creates sessions without a project so they go into the plugin project.",
  "extension": {
    "engines": { "zcode": "^1.3.0" },
    "main": "./extension.js",
    "activationEvents": ["onAvailable"],
    "grants": ["sessions.write"],
    "protocols": { "sessions": 1, "rows": 4 },
    "contributes": {
      "commands": [
        {
          "id": "run-step",
          "title": { "zh-CN": "E2E 执行项目步骤", "en-US": "E2E run project step" }
        }
      ]
    }
  },
  "slots": {
    "composer.status": [
      { "id": "run", "icon": "message-square", "target": { "command": "run-step" } }
    ]
  }
}
