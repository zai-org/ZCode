{
  "version": 1,
  "caseName": "conversation-session-v4-composer-toolbar",
  "spec": "./test/e2e/conversation-session/composer/conversation-session-v4-composer-toolbar.test.ts",
  "fixtures": [
    {
      "id": "v4-composer-toolbar-title",
