{
  "name": "@zcode/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session-control": {
      "types": "./dist/tool/session-control/contract.d.ts",
      "import": "./dist/tool/session-control/contract.js"
    },
    "./repl": {
      "types": "./dist/repl/node-repl-session.d.ts",
      "import": "./dist/repl/node-repl-session.js"
    },
    "./browser-client": {
      "types": "./dist/browser-client/index.d.ts",
      "import": "./dist/browser-client/index.js"
    },
    "./create-workflow-graph-bounds": {
      "types": "./dist/tool/handlers/create-workflow-graph-bounds.d.ts",
      "import": "./dist/tool/handlers/create-workflow-graph-bounds.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest tests",
    "coverage": "vitest run tests --coverage",
    "lint": "oxlint src --no-ignore",
    "lint:fix": "oxlint --fix src --no-ignore"
  },
  "dependencies": {
    "@zcode/contracts": "workspace:*",
    "@zcode/dynamic-workflow": "workspace:*",
    "@zcode/session-control": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/shared-types": "workspace:*",
    "@zcode/zcode-cua": "workspace:*",
    "cheerio": "^1.0.0",
    "diff": "^9.0.0",
    "ipaddr.js": "1.9.1",
    "marked": "16.4.2",
    "meriyah": "^7.1.1",
    "unbash": "4.0.1",
    "yaml": "^2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.1.5"
  }
}
