      "id": "telemetry-parity-title",
      "description": "核心差分五个新 session 共用的非流式标题响应。",
      "metadata": {
        "kind": "common",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "标题不属于对话埋点统计口径；固定成功可避免后台 title 重试干扰主链路时序。"
      },
      "maxMatches": 5,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_TELEMETRY_PARITY"]
      },
      "response": {
        "statusCode": 200,
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "body": "{\"id\":\"telemetry-parity-title\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"deepseek-v4-flash\",\"content\":[{\"type\":\"text\",\"text\":\"{\\\"title\\\":\\\"Telemetry Parity\\\"}\"}],\"stop_reason\":\"end_turn\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":64,\"output_tokens\":8}}"
      }
    },
