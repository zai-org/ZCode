        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "edit 前的原始回复，编辑后应被新 query 的回复替换。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
