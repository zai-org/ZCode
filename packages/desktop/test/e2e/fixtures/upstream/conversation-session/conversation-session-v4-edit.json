      "response": {
        "statusCode": 200,
        "text": {
          "id": "v4-edit-title",
          "inputTokens": 64,
          "outputTokens": 8,
          "text": "{\"title\":\"V4 Edit E2E\"}"
        }
      }
    },
    {
      "id": "v4-edit-original",
      "description": "M4 editUserQuery 门禁：原始 turn 回复。",
