          "name": "CronPauseSelf",
          "input": {}
        }
      }
    },
    {
      "id": "upstream-conversation-automation-pause-self-final",
      "description": "CronPauseSelf 成功结果进入历史后返回简短普通文本，稳定完成整轮。",
