      "metadata": {
        "kind": "common",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "E2E_V4_COMPOSER_TOOLBAR_SEED 首发会触发默认 title sidecar；固定 case-local 标题响应，避免 default replay 回退 legacy provider-basic，并用该首发 marker 隔离跨 case 匹配。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_V4_COMPOSER_TOOLBAR_SEED"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "v4-composer-toolbar-title",
          "inputTokens": 64,
          "outputTokens": 8,
          "text": "{\"title\":\"V4 Composer Toolbar E2E\"}"
        }
      }
    },
    {
      "id": "v4-composer-toolbar-seed",
      "description": "M5 composer 工具条门禁：首轮固定回复，建立可切模型/模式的 session（usage 投影随 ModelComplete 写入）。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "工具条切换使用已存在 session；目录 owner、桌面配置 ACK 及手机同 workspace A/B 回归创建额外会话，首轮文案固定。"
      },
      "maxMatches": 5,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_V4_COMPOSER_TOOLBAR_SEED"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "v4-composer-toolbar-seed",
          "inputTokens": 80,
          "outputTokens": 8,
          "text": "V4_COMPOSER_TOOLBAR_SEED_OK"
        }
      }
    },
    {
      "id": "provider-pending-send",
      "description": "Provider 目录与跨会话配置 ACK 挂起后的发送回归",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "固定回复用于确认阻止旧选择提交后可正常发送"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_PROVIDER_PENDING_SEND"],
        "bodyExcludes": ["Generate a concise title"]
