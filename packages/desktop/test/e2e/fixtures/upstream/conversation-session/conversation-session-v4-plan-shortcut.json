    },
    {
      "id": "v4-plan-shortcut-task-two",
      "description": "关闭 Plan 后发送原始 /plan 文本，不发生隐式模式切换。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
