{
  "version": 1,
  "caseName": "conversation-session-highspeed-queue-edit",
  "spec": "./test/e2e/conversation-session/entitlements/conversation-session-highspeed-queue-edit.test.ts",
  "fixtures": [
    {
      "id": "highspeed-queue-edit-running-turn",
