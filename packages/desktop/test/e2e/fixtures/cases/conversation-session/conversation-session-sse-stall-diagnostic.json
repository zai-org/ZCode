    {
      "id": "sse-stall-post-tool-continuation-stalled",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fault-stream",
      "syntheticReason": "把 stall 放在已成功执行工具之后，验证恢复不会重放工具。"
