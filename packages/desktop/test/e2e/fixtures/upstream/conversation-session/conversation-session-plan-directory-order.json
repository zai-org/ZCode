      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_PLAN_DIRECTORY_ORDER"],
        "bodyIncludes": [
          "E2E_PLAN_DIRECTORY_ORDER",
          "E2E_PLAN_DIRECTORY_ENTER",
          "E2E_PLAN_DIRECTORY_EXIT"
        ],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_plan_directory_enter_plan_mode",
          "name": "EnterPlanMode",
          "input": {}
