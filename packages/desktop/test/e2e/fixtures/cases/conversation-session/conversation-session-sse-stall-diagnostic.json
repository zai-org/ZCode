    },
    {
      "id": "sse-stall-prelude-recovered",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fast-text",
      "syntheticReason": "证明 retry-safe prelude 能通过真实第二次 provider request 收口。"
    },
    {
      "id": "sse-stall-thinking-stalled",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fault-stream",
      "syntheticReason": "在 reasoning-only visible boundary 制造真实 SSE stall。"
    },
    {
      "id": "sse-stall-thinking-recovered",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fast-text",
      "syntheticReason": "验证 S02-R1 的真实 Desktop recovery 请求。"
    },
    {
      "id": "sse-stall-text-stalled",
      "kind": "main",
      "source": "synthetic",
      "timingPolicy": "fault-stream",
      "syntheticReason": "在用户可见正文边界制造真实 SSE stall，采样 S03 当前行为。"
