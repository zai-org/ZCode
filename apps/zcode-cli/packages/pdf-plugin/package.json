{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/pdf-plugin",
  "version": "0.2.3",
  "private": true,
  "description": "PDF production skills and a PDF viewer panel, published as an official ZCode plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node ../office-runtime/scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "smoke": "node ../office-runtime/scripts/smoke.mjs",
    "test:e2e": "node ../office-runtime/scripts/e2e.mjs"
  },
  "devDependencies": {
    "@zcode/office-runtime": "workspace:*"
  },
  "office": {
    "title": {
      "en": "PDF",
      "zh-CN": "PDF"
    },
    "kinds": [
      "pdf"
    ]
  }
}
